# Copy to backend/.env and fill in. Never commit the real .env.

# Which provider serves /api/tasks: "gemma" (local mock, free) or "youcam" (real, costs credits)
PROVIDER=gemma

# --- gemma mock ---
OLLAMA_URL=http://localhost:11434/api/chat
GEMMA_MODEL=gemma4:cloud

# --- real YouCam (only needed when PROVIDER=youcam) ---
# Get a key at https://yce.makeupar.com/api-console/en/api-keys/
# V2 uses a plain Bearer key — no RSA handshake, no client id.
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# Print every YouCam request/response. Useful while wiring, noisy afterwards.
YOUCAM_DEBUG=0

# YouCam's ui_score is 0-100 where higher means healthier skin, so we invert it to get
# "how much of this concern". Set to 0 if a probe run shows the direction is reversed.
YOUCAM_INVERT_SKIN_SCORES=1
